# Gravity SOC - Variables de entorno
# Copia este archivo a .env y ajusta los valores

# === SERVER (L2) ===
# Puerto de escucha del servidor
GRAVITY_PORT=:8443

# Ruta de la base de datos SQLite
GRAVITY_DB_PATH=./gravity-soc.db

# API key para autenticar agentes (vacio = modo abierto)
GRAVITY_API_KEY=

# Ventana de correlacion en segundos
GRAVITY_CORRELATION_WINDOW=10s

# Dias de retencion de eventos en DB
GRAVITY_RETENTION_DAYS=30

# Webhook para alertas (Slack, TheHive, sec-dashboard)
GRAVITY_WEBHOOK_URL=

# === AGENT (L1) ===
# URL del servidor L2
GRAVITY_SERVER_URL=http://127.0.0.1:8443/api/v1/events

# API key (debe coincidir con el servidor)
GRAVITY_API_KEY=

# Ruta del log DNS (Linux/Raspberry Pi)
GRAVITY_LOG_PATH=/var/log/soc_alerts.log